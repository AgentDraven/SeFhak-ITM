{
  "name": "itm",
  "version": "0.3.36",
  "description": "ITM customer front end for the ITM store on shared MERIT services",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node scripts/provider-main.mjs && node scripts/build.mjs",
    "providers:sync": "node scripts/provider-main.mjs --sync",
    "providers:check": "node scripts/provider-main.mjs",
    "verify": "node scripts/provider-main.mjs && node scripts/build.mjs && node scripts/verify.mjs && node scripts/test-fork-contract.mjs",
    "e2e": "node scripts/build.mjs && node scripts/e2e-smoke.mjs",
    "e2e:playwright": "node scripts/build.mjs && node scripts/e2e-playwright.mjs",
    "test:alpha-contract": "node scripts/test-alpha-contract.mjs",
    "test:alpha-registration:flow": "node scripts/test-alpha-registration-flow.mjs",
    "test:fork-contract": "node scripts/build.mjs && node scripts/test-fork-contract.mjs",
    "test:alpha-registration": "node scripts/test-alpha-registration.mjs",
    "test:alpha-session": "node scripts/test-alpha-session.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.49.0"
  },
  "devDependencies": {
    "playwright": "^1.61.1"
  }
}
